# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Decap CMS (GitHub OAuth) — local dev uses `npm run cms` instead; OAuth is for production only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DECAP_OAUTH_REDIRECT_URI=http://localhost:3000/api/decap-callback

