# NEXT_PUBLIC_SITE_URL=https://www.r2-live.at
# DECAP_OAUTH_REDIRECT_URI=https://www.r2-live.at/api/decap-callback

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=booking@r2-live.at
